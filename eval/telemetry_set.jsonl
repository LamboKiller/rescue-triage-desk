{"id":"wrong-channel","description":"Three accurate fixes stay half a kilometre north of the mission corridor.","bind":true,"fixes":[{"t":10,"lat":-29.995},{"t":20,"lat":-29.995},{"t":30,"lat":-29.995}],"expect":{"alerts":["gps_off_route"],"proposal":false,"units":1}}
