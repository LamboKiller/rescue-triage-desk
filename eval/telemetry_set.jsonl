{"id":"poor-antenna","description":"A tracker reports a distant point with a 500 metre uncertainty; retain it only for audit.","bind":true,"fixes":[{"t":10},{"t":20,"lat":-29.99,"accuracy":500},{"t":30,"lat":-29.99,"accuracy":500},{"t":40,"lat":-29.99,"accuracy":500}],"expect":{"alerts":[],"proposal":false,"units":1,"last_t":10,"outcomes":["accepted","low_confidence","low_confidence","low_confidence"]}}
