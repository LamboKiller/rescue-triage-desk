# Copy to .env (gitignored). Placeholders only: never paste real keys into source, chat or commits.
# --- Runtime mode ---
# true = offline sample mode: local CSVs, no Zetaris/Nightshift/network (regex baseline + deterministic checks).
SAMPLE_MODE=true
# HTTP port of `python run.py serve` (server binds 0.0.0.0).
PORT=8080

# --- Meterless Nightshift (primary AI provider, OpenAI-compatible) ---
# Base URL of the local Nightshift endpoint (use http://host.docker.internal:8088/v1 from a container).
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
# Nightshift API key.
NIGHTSHIFT_API_KEY=replace_with_local_key
# If NIGHTSHIFT_BASE_URL / NIGHTSHIFT_API_KEY are unset, METERLESS_BASE_URL / METERLESS_RUNTIME_TOKEN are read instead.
# Per-call timeout in seconds (bounded retries apply on top).
NIGHTSHIFT_CALL_TIMEOUT=75
# Requested model lane; the routed model is logged per call.
NIGHTSHIFT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Global cap on simultaneous model calls (default 2). Keep low: Nightshift stalls under bursts.
NIGHTSHIFT_MAX_CONCURRENCY=2
# max_tokens per call (default 6000). Do not lower: thinking tokens count against it.
NIGHTSHIFT_MAX_TOKENS=6000

# --- Zetaris data layer (connected mode) ---
# Zetaris REST endpoint (use host.docker.internal from a container).
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
# Zetaris API key.
ZETARIS_API_KEY=replace_with_local_key
# Zetaris organization id.
ZETARIS_ORG_ID=replace_with_local_org_id
# Runtime tables (v4), registered by `python tools/load_zetaris.py --version v4`.
ZETARIS_STREETS_TABLE=streets_flood_v4
ZETARIS_MESSAGES_TABLE=messages_seed7_v4
ZETARIS_LANDMARKS_TABLE=landmarks_v4
ZETARIS_CLOSURES_TABLE=closures_v4
ZETARIS_PUMP_STATUS_DAILY_TABLE=pump_status_daily_v4
ZETARIS_PUMPS_TABLE=pumps_v4
ZETARIS_EVENTS_TABLE=events_v4
ZETARIS_SHELTERS_TABLE=shelters_v4
ZETARIS_STREET_POINTS_TABLE=street_points_v4
# Also loaded: OAH_S3.road_closures_v4 and OAH_S3.landmark_aliases_v4.
# Runtime aliases come from the local curated CSV (data/landmark_aliases.csv), not the alias table.

# --- S3 / SeaweedFS (used by tools/load_zetaris.py to stage CSVs for Zetaris) ---
# S3 endpoint as seen from the host.
S3_ENDPOINT_HOST=127.0.0.1:8333
# S3 endpoint as seen from Zetaris containers (their Docker network).
S3_ENDPOINT_INTERNAL=http://oah-s3:8333
# S3 access key.
S3_ACCESS_KEY=replace_with_local_key
# S3 secret key.
S3_SECRET_KEY=replace_with_local_secret
# S3 bucket holding the CSV tables.
S3_BUCKET=oah-s3

# --- Behaviour tuning (optional) ---
# Hours after which an active case's last observation counts as stale (default 6).
STALE_HOURS=6
# 1 = synthetic callback simulator answers callbacks for synthetic cases; 0 = disabled (default 1).
CALLBACK_SIMULATOR=1
# Folder with the D1-D3 data backup for tools/prepare_*.py and fetch_landmarks.py (default ./data-backup).
RTD_BACKUP_DIR=data-backup

# --- Remote access tokens (optional; loopback requests never need them) ---
# Bearer token for operator actions from a non-loopback client. Leave empty to refuse remote operator actions.
RESCUE_OPERATOR_TOKEN=replace_with_local_token
# Separate bearer token for remote device (GPS) ingest.
RESCUE_DEVICE_TOKEN=replace_with_local_token

# --- Feature flags / paths (optional) ---
# 1 = critic + revision in ONE verifier call (default off).
RTD_VERIFIER=0
# Where the agent-contribution counters are written (default runtime/agent_contribution.json).
RTD_CONTRIBUTION_PATH=runtime/agent_contribution.json
